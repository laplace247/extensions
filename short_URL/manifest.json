{
  "manifest_version": 3,
  "name": "Acortador de URL",
  "version": "1.0",
  "description": "Acorta URLs de forma rápida y sencilla",
  "permissions": [
    "activeTab"
  ],
  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Acortar URL",
    "default_icon": {
      "16": "img/icon16.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  }
}