{
  "manifest_version": 3,
  "name": "ToDo App",
  "version": "1.0",
  "description": "Una aplicación de tareas simple y elegante",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ToDo App"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}