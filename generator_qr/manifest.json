{
  "manifest_version": 3,
  "name": "Generador QR",
  "version": "1.0",
  "description": "Genera códigos QR personalizables directamente desde tu navegador",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Generador QR"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}