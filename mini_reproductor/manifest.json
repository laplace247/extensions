{
  "manifest_version": 3,
  "name": "Mini Music Player",
  "version": "1.0",
  "description": "Un reproductor de música minimalista para Chrome",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mini Music Player"
  },
  "permissions": [
    "storage"
  ],

  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  }
}