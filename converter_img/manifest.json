{
  "manifest_version": 3,
  "name": "Convertidor PNG",
  "version": "1.1",
  "description": "Convierte archivos JFIF/WEBP a PNG de forma masiva con modo oscuro",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Convertidor JFIF a PNG"
  },
  "icons": {
    "16": "img/logo16.png",
    "48": "img/logo48.png",
    "128": "img/logo128.png"
  }
}